<div class="layout layout--col layout--left gap--small">

  <div class="grid grid--cols-2 gap--large w--full">

    <div class="flex flex--col flex--left gap--none">
      <span class="label label--small">State of charge</span>
      <div class="flex flex--row flex--bottom gap--xsmall">
        <span class="value value--xxlarge value--tnums">{{ soc }}</span>
        <span class="value value--small">%</span>
      </div>
    </div>

    <div class="flex flex--col flex--left flex--center-y gap--small w--full">
      {% render "stat", label: "Range", value: range, unit: distance_unit %}
      <div class="divider"></div>
      {% render "stat", label: "Cabin", value: cabin_display %}
    </div>

  </div>

  <div class="progress-bar progress-bar--small w--full">
    <div class="track">
      <div class="fill" style="width: {{ soc }}%"></div>
      <div class="charge-limit" style="left: {{ soc_limit }}%"></div>
    </div>
  </div>

  <div class="flex flex--row flex--center-y flex--between w--full">
    <div class="flex flex--row flex--center-y gap--small">
      <span class="label label--small">{% if charging %}{{ mode_detail }} &middot; {{ eta }}{% else %}{{ mode }}{% endif %}</span>
      {% if low_charge %}<span class="label label--small label--filled">Low charge</span>{% endif %}
    </div>
    {% if secure %}
      <span class="label label--small">Locked &middot; All closed</span>
    {% else %}
      <span class="label label--small label--filled" data-clamp="1">
        {% unless locked %}Unlocked{% if open_count > 0 %} &middot; {% endif %}{% endunless %}{% if open_count > 0 %}{{ closure_summary }}{% endif %}
      </span>
    {% endif %}
  </div>

</div>

<div class="title_bar">
  <img class="image" src="/images/plugins/trmnl--render.svg" />
  <span class="title">{{ vehicle }}</span>
  <span class="instance">Updated {{ updated_fmt }}</span>
</div>
