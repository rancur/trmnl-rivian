<div class="layout layout--col layout--left gap--medium">

  <!-- Band 1: the number you read from across the room, plus supporting figures -->
  <div class="grid grid--cols-2 gap--large w--full">

    <div class="col--span-1 flex flex--col flex--left gap--none">
      <span class="label label--small">State of charge</span>
      <div class="flex flex--row flex--bottom gap--xsmall">
        <span class="value value--mega value--tnums">{{ soc }}</span>
        <span class="value value--large">%</span>
      </div>
    </div>

    <div class="col--span-1 flex flex--col flex--left flex--center-y gap--small w--full">
      {% render "stat", label: "Range", value: range, unit: distance_unit %}
      <div class="divider"></div>
      {% render "stat", label: "Cabin", value: cabin_display %}
      <div class="divider"></div>
      {% if charging %}
        {% render "stat", label: "Full in", value: eta %}
      {% else %}
        {% render "stat", label: "Odometer", value: odometer_fmt, unit: distance_unit %}
      {% endif %}
    </div>

  </div>

  <!-- Band 2: the same number as a shape, with a tick at the charge limit -->
  <div class="flex flex--col flex--left gap--small w--full">
    <div class="progress-bar progress-bar--large w--full">
      <div class="track">
        <div class="fill" style="width: {{ soc }}%"></div>
        <div class="charge-limit" style="left: {{ soc_limit }}%"></div>
      </div>
    </div>
    <div class="flex flex--row flex--center-y flex--between w--full">
      <div class="flex flex--row flex--center-y gap--small">
        <span class="label label--small">{{ mode_detail }}</span>
        {% if low_charge %}<span class="label label--small label--filled">Low charge</span>{% endif %}
        {% if preconditioning %}<span class="label label--small label--outline">Preconditioning</span>{% endif %}
        {% if pet_mode %}<span class="label label--small label--outline">Pet mode</span>{% endif %}
        {% if tire_alert %}<span class="label label--small label--outline">Tire pressure</span>{% endif %}
      </div>
      <span class="label label--small">Limit {{ soc_limit }}%</span>
    </div>
  </div>

  <!-- Band 3: calm when the truck is buttoned up, emphatic when it isn't -->
  <div class="flex flex--col gap--small w--full">
    <div class="divider"></div>
    <div class="grid grid--cols-4 gap--large w--full">
      {% render "closure", label: "Doors", items: doors_open %}
      {% render "closure", label: "Windows", items: windows_open %}
      {% render "closure", label: "Storage", items: storage_open %}

      <div class="flex flex--col flex--left gap--xsmall">
        <span class="label label--small">Security</span>
        {% if locked %}
          <span class="label label--gray">Locked</span>
        {% else %}
          <span class="label label--filled">Unlocked</span>
        {% endif %}
      </div>
    </div>
  </div>

</div>

<div class="title_bar">
  <img class="image" src="/images/plugins/trmnl--render.svg" />
  <span class="title">{{ vehicle }}</span>
  <span class="instance">Updated {{ updated_fmt }}</span>
</div>
