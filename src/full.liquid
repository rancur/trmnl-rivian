<div class="layout layout--col layout--left gap--medium">

  <div class="grid grid--cols-4 gap--large w--full">

    <!-- Charge, and the figures you'd act on -->
    <div class="col--span-3 flex flex--col flex--left gap--small w--full">

      <div class="flex flex--row flex--center-y gap--small">
        <span class="title title--small">{{ status_line }}</span>
        {% if low_charge %}<span class="label label--small label--filled">Low charge</span>{% endif %}
        {% if preconditioning %}<span class="label label--small label--outline">Preconditioning</span>{% endif %}
        {% if pet_mode %}<span class="label label--small label--outline">Pet mode</span>{% endif %}
      </div>

      <div class="flex flex--row flex--bottom gap--xsmall">
        <span class="value value--xxxlarge value--tnums">{{ soc }}</span>
        <span class="value value--base">%</span>
      </div>

      <div class="progress-bar progress-bar--base w--full">
        <div class="track">
          <div class="fill" style="width: {{ soc }}%"></div>
          <div class="charge-limit" style="left: {{ soc_limit }}%"></div>
        </div>
      </div>

      {% if show_last_charge %}
        <div class="w--full" style="position: relative; height: 7px">
          <div class="charge-session"
               style="left: {{ last_charge_start_soc }}%; width: {{ last_charge_delta }}%"></div>
        </div>
      {% endif %}

      <div class="flex flex--row flex--center-y flex--between w--full">
        <span class="label label--small">
          {%- if charging and charge_power > 0 -%}
            {{ charge_power }} kW &middot; {{ eta }} to limit
          {%- elsif show_last_charge -%}
            Last charge +{{ last_charge_delta }}% &middot; {{ last_charge_kwh }} kWh &middot; {{ last_charge_fmt }}
          {%- endif -%}
        </span>
        <span class="label label--small">Limit {{ soc_limit }}%</span>
      </div>

      <div class="divider"></div>

      <div class="grid grid--cols-3 gap--medium w--full">
        {% render "stat", label: "Range", value: range, unit: distance_unit %}
        {% render "stat", label: "Cabin", value: cabin_display %}
        {% render "stat", label: "Odometer", value: odometer_fmt, unit: distance_unit %}
      </div>

    </div>

    <!-- The truck itself: anything open fills solid -->
    <div class="col--span-1 flex flex--col flex--center-x w--full">
      <div class="w--full flex flex--row flex--center-x flex--center-y" style="height: 288px">
        {% if vehicle_image_url %}
          <img class="image image-dither image--contain" src="{{ vehicle_image_url }}"
               style="max-width:100%;max-height:100%" />
        {% else %}
          {{ vehicle_svg }}
        {% endif %}
      </div>
    </div>

  </div>

  <!-- Everything the truck could be unhappy about, in one row -->
  <div class="flex flex--col gap--small w--full">
    <div class="divider"></div>
    <div class="flex flex--row flex--center-y flex--left gap--medium w--full">
      {% render "check", label: "Locked", ok: locked %}
      {% render "check", label: "Closed", ok: closures_ok %}
      {% render "check", label: "Tires", ok: tires_ok %}
      {% render "check", label: "12V", ok: battery_12v_ok %}
      {% render "check", label: "Fluids", ok: fluids_ok %}
      {% render "check", label: "Software", ok: software_ok %}
    </div>

    {%- comment -%}
      Its own full-width line: with five things open the list is far too long to
      share a row with the checks.
    {%- endcomment -%}
    {% unless closures_ok %}
      <span class="label label--small" data-clamp="1">{{ closure_summary }}</span>
    {% endunless %}
  </div>

</div>

<div class="title_bar">
  {% if logo_url %}
    <img class="image" src="{{ logo_url }}" />
  {% else %}
    {{ vehicle_mark }}
  {% endif %}
  <span class="title">{{ display_name }}</span>
  <span class="instance">Updated {{ updated_fmt }}</span>
</div>
