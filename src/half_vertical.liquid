<div class="layout layout--col layout--left gap--small">

  <div class="flex flex--col flex--left gap--none">
    <div class="flex flex--row flex--center-y gap--xsmall">
      <span class="title title--small">{{ status_line }}</span>
      {% if stale %}<span class="label label--small label--filled">{{ stale_label }}</span>{% endif %}
    </div>
    <div class="flex flex--row flex--bottom gap--xsmall">
      <span class="value value--xxlarge value--tnums">{{ soc_display }}</span>
      {% if soc_known %}<span class="value value--small">%</span>{% endif %}
    </div>
  </div>

  <div class="flex flex--col flex--left gap--small w--full">
    <div class="progress-bar progress-bar--small w--full">
      <div class="track">
        {% if soc_known %}<div class="fill" style="width: {{ soc }}%"></div>{% endif %}
        {% if soc_limit != nil %}<div class="charge-limit" style="left: {{ soc_limit }}%"></div>{% endif %}
      </div>
    </div>
    <div class="flex flex--row flex--between w--full">
      <span class="label label--small" data-clamp="1">{{ charge_line }}</span>
      {% if soc_limit != nil %}<span class="label label--small">Limit {{ soc_limit }}%</span>{% endif %}
    </div>
  </div>

  <div class="divider"></div>

  <div class="grid grid--cols-3 gap--small w--full">
    <div class="col--span-2 flex flex--col flex--left gap--small w--full">
      {% render "stat", label: "Range", value: range_display, unit: range_unit %}
      {% render "stat", label: "Cabin", value: cabin_display %}
      {% if charging == true %}
        {% render "stat", label: "Full in", value: eta %}
      {% else %}
        {% render "stat", label: "Odometer", value: odometer_display, unit: odometer_unit %}
      {% endif %}
    </div>
    <div class="col--span-1 flex flex--col flex--center-x w--full">
      <div class="w--full" style="height: 150px">
        {{ vehicle_svg }}
      </div>
    </div>
  </div>

  <div class="flex flex--col flex--left gap--xsmall w--full">
    <div class="divider"></div>
    <div class="flex flex--row flex--center-y flex--left gap--small w--full">
      {% render "check", label: "Locked", ok: locked %}
      {% render "check", label: "Closed", ok: closures_ok %}
      {% render "check", label: "Tires", ok: tires_ok %}
      {% render "check", label: "12V", ok: battery_12v_ok %}
    </div>
    {% if closures_ok == false %}
      <span class="label label--small" data-clamp="1">{{ closure_summary }}</span>
    {% endif %}
  </div>

</div>

<div class="title_bar">
  {% if logo_url %}<img class="image" src="{{ logo_url }}" />{% else %}{{ vehicle_mark }}{% endif %}
  <span class="title">{{ display_name }}</span>
  {%- comment -%} Narrowest title bar with a timestamp: drops the weekday, keeps
    the date, because the date is the part that survives a frozen screen. {%- endcomment -%}
  <span class="instance">{% if updated_short != "" %}{{ updated_short }}{% else %}No data{% endif %}</span>
</div>
